// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String @id @default(cuid())
  clerkId      String @unique
  email        String @unique
  firstName    String?
  lastName     String?
  imageUrl     String?
  role         Role   @default(USER)
  customPrompt String?
  personalityType PersonalityType @default(professional)
  systemMessage String?
  calendarConnected Boolean @default(false)
  timezone String? @default("UTC")
  
  // Org chart fields
  employeeId   String? @unique
  title        String?
  department   String?
  managerId    String?
  isExplicitRoot Boolean @default(false) // Track explicitly designated root nodes (managerId was '0' in CSV or manually set)
  manager      User?   @relation("UserManager", fields: [managerId], references: [id])
  directReports User[] @relation("UserManager")
  
  // Chat relationships
  chatsAsUser     Chat[] @relation("UserChats")
  chatsAsEmployee Chat[] @relation("EmployeeChats")
  messages        Message[]
  notifications   Notification[]
  
  // RAG documents
  documents       Document[]

  // Task relationships
  tasksCreated    Task[] @relation("TasksCreated")
  tasksAssigned   Task[] @relation("TasksAssigned")
  taskComments    TaskComment[]

  // Mention relationships
  mentionsReceived TaskMention[] @relation("MentionsReceived")
  mentionsMade     TaskMention[] @relation("MentionsMade")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Chat {
  id         String @id @default(cuid())
  userId     String // The user initiating the chat
  employeeId String // The employee being chatted with
  
  user     User @relation("UserChats", fields: [userId], references: [id])
  employee User @relation("EmployeeChats", fields: [employeeId], references: [id])
  
  messages Message[]
  notifications Notification[]
  
  // Session tracking
  lastActivityAt DateTime @default(now())
  isActive Boolean @default(true)
  endedAt DateTime?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, employeeId])
  @@map("chats")
}

model Message {
  id      String @id @default(cuid())
  chatId  String
  userId  String
  role    MessageRole
  content String
  
  chat Chat @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@map("messages")
}

model Notification {
  id          String @id @default(cuid())
  userId      String // The user who should receive the notification (employee being chatted with)
  chatId      String? // The chat that triggered this notification (optional for task notifications)
  type        NotificationType
  title       String
  message     String
  isRead      Boolean @default(false)

  user User @relation(fields: [userId], references: [id])
  chat Chat? @relation(fields: [chatId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("notifications")
}

enum Role {
  ADMIN
  USER
}

enum MessageRole {
  user
  assistant
  system
}

enum PersonalityType {
  professional
  friendly
  technical
  creative
  analytical
  supportive
  direct
  mentor
}

enum NotificationType {
  CHAT_STARTED
  CHAT_ENDED
  MEETING_BOOKED
  CALENDAR_UPDATED
  TASK_ASSIGNED
  TASK_COMPLETED
  TASK_COMMENT
  TASK_MENTIONED
  DOCUMENT_SHARED
  TASK_FROM_DOCUMENT
}

model Document {
  id          String @id @default(cuid())
  userId      String

  // Document categorization
  scope       DocumentScope @default(PERSONAL)
  category    String?  // e.g., "Meeting Transcripts", "Initiatives", "Policies"

  fileName    String
  fileType    String // 'txt', 'md', 'pdf' (future)
  content     String @db.Text
  metadata    Json?  // { uploadedBy, fileSize, tags, source }

  // AI-enhanced fields
  summary     String?  @db.Text  // AI-generated summary
  extractedEntities Json?       // AI-extracted: people, dates, action items

  // Access control
  isPublic    Boolean  @default(false)
  sharedWith  String[] // Array of user IDs

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relationships
  tasks       TaskDocument[]  // Many-to-many with tasks

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([scope])
  @@index([category])
  @@map("documents")
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)
  dueDate     DateTime?

  createdById  String
  assignedToId String?

  // AI & Source tracking
  sourceType     TaskSourceType? @default(MANUAL)
  sourceDocumentId String?       // If created from document
  aiGenerated    Boolean @default(false)
  aiContext      Json?           // Store AI reasoning/extraction data

  // Enhanced metadata
  tags           String[]        // Searchable tags

  createdBy   User @relation("TasksCreated", fields: [createdById], references: [id])
  assignedTo  User? @relation("TasksAssigned", fields: [assignedToId], references: [id])

  comments    TaskComment[]
  documents   TaskDocument[]  // Many-to-many with documents
  mentions    TaskMention[]   // Track @mentions in task

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedToId])
  @@index([createdById])
  @@index([status])
  @@index([sourceType])
  @@map("tasks")
}

model TaskComment {
  id      String @id @default(cuid())
  taskId  String
  userId  String
  content String @db.Text

  task    Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User @relation(fields: [userId], references: [id])
  mentions TaskMention[] // @mentions in this comment

  createdAt DateTime @default(now())

  @@index([taskId])
  @@map("task_comments")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskDocument {
  id         String   @id @default(cuid())
  taskId     String
  documentId String

  // Relationship metadata
  linkType   TaskDocLinkType @default(REFERENCE)
  notes      String? @db.Text

  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  createdAt  DateTime @default(now())

  @@unique([taskId, documentId])
  @@index([taskId])
  @@index([documentId])
  @@map("task_documents")
}

model TaskMention {
  id          String   @id @default(cuid())
  taskId      String?  // Task being mentioned in
  commentId   String?  // Or comment being mentioned in

  mentionedUserId String  // User who was @mentioned
  mentionedBy     String  // User who did the mentioning

  context     String?  @db.Text  // Text around the mention
  isRead      Boolean  @default(false)

  task        Task?        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  comment     TaskComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUser User @relation("MentionsReceived", fields: [mentionedUserId], references: [id])
  mentioner     User @relation("MentionsMade", fields: [mentionedBy], references: [id])

  createdAt   DateTime @default(now())

  @@index([mentionedUserId])
  @@index([taskId])
  @@index([commentId])
  @@map("task_mentions")
}

enum DocumentScope {
  PERSONAL  // Only visible to creator
  TEAM      // Visible to department/team
  COMPANY   // Visible to all employees
}

enum TaskSourceType {
  MANUAL       // Created manually by user
  COPILOT      // Created via AI copilot
  TRANSCRIPT   // Extracted from meeting transcript
  DOCUMENT     // Extracted from document
  EMAIL        // Future: from email
}

enum TaskDocLinkType {
  REFERENCE    // Document referenced in task
  SOURCE       // Task created FROM this document
  ATTACHMENT   // Document attached for context
} 